# Anthropic API 키 (실제 값은 .env에만 저장, 커밋 금지)
ANTHROPIC_API_KEY=
# 분류에 쓸 모델. 대량 분류 비용을 줄이려면 claude-haiku-5-5 로 변경
CLASSIFY_MODEL=claude-opus-5-5
DATABASE_URL=postgresql://bai:bai@localhost:5432/bai
# 자연어 질문 답변 모델
ASK_MODEL=claude-opus-5-5
# 임베딩: local(권장, BAAI/bge-m3) | voyage | hash(테스트용)
EMBED_BACKEND=local
# VOYAGE_API_KEY=
